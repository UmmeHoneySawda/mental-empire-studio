{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mental-empire.local/schemas/openmontage/job-package.v1.schema.json",
  "title": "Mental Empire Studio OpenMontage Job Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contractVersion",
    "jobId",
    "projectId",
    "createdAt",
    "requestedBy",
    "project",
    "source",
    "production",
    "output",
    "fallback"
  ],
  "properties": {
    "schema": { "const": "mes.openmontage.job/v1" },
    "contractVersion": { "const": "mes.openmontage/v1" },
    "jobId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "requestedBy": { "const": "mental-empire-studio" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "sourceProjectId": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "assets"],
      "properties": {
        "narrationPath": { "type": "string", "minLength": 1 },
        "scriptPath": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "kind", "locked"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["image", "video", "audio", "caption", "other"] },
              "locked": { "type": "boolean" },
              "sceneId": { "type": "string" },
              "sourceUrl": { "type": "string" },
              "attribution": { "type": "string" }
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fps", "durationSeconds", "crossfadeSeconds", "scenes"],
      "properties": {
        "version": { "const": "1.0" },
        "fps": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "minimum": 0 },
        "crossfadeSeconds": { "type": "number", "minimum": 0 },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "order",
              "type",
              "startSeconds",
              "endSeconds",
              "durationSeconds",
              "locked"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 0 },
              "type": { "enum": ["image", "video", "text_card", "gap"] },
              "assetId": { "type": "string", "minLength": 1 },
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "locked": { "type": "boolean" },
              "motion": {
                "type": "object",
                "additionalProperties": false,
                "required": ["preset", "direction", "amount"],
                "properties": {
                  "preset": { "enum": ["off", "subtle", "cinematic"] },
                  "direction": { "enum": ["auto", "push", "pull", "left", "right", "up", "down"] },
                  "amount": { "type": "number", "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowMode", "pipeline", "mediaControl", "style", "composition", "approvals"],
      "properties": {
        "workflowMode": { "enum": ["automatic", "mental-empire-studio", "openmontage"] },
        "pipeline": { "enum": ["hybrid", "documentary-montage", "framework-smoke"] },
        "mediaControl": { "enum": ["preserve", "improve", "fill", "automatic"] },
        "style": { "type": "string", "minLength": 1 },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "authoringMode", "editableOutput"],
          "properties": {
            "runtime": { "enum": ["automatic", "remotion", "hyperframes", "ffmpeg"] },
            "authoringMode": { "enum": ["templated", "atelier"] },
            "editableOutput": { "type": "boolean" }
          }
        },
        "approvals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["preparing", "research", "script", "scene_plan", "assets", "edit", "compose", "export"]
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "aspectRatio", "width", "height", "format", "captions"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "aspectRatio": { "enum": ["16:9", "1:1", "9:16"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "const": "mp4" },
        "captions": { "type": "boolean" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "engine", "preserveOpenMontageProject"],
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "const": "mental-empire-studio" },
        "preserveOpenMontageProject": { "type": "boolean" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}
